__pycache__/
*.pyc
.venv/
venv/
node_modules/
.next/
.env
.env.local

# Deny everything under data/, then name what is allowed back in. A 237 MB
# source zip was committed here once by accident; an allow-list is the version
# of this file that could not have let that happen.
data/*

# The collected record. This IS the project's output and belongs in git - the
# commit history is what makes the log append-only in a way a reader can check
# without trusting the code that wrote it.
!data/events/
data/events/*
!data/events/*.ndjson

!data/state/
data/state/*
!data/state/open.json
# The heartbeat, which is how coverage credits a run that is still going and how
# a run that died without writing its coverage row is recovered. It was left out
# of this list when it was added, so the live-run coverage fix silently did
# nothing in CI - the file never got there. See FINDINGS M1-T8f.
!data/state/collector.json
# The three runs whose coverage can never be recovered. Tracked because it is
# the record of a permanent hole, and a hole nobody can see is not recorded.
!data/state/orphan_runs.json

!data/runs.ndjson
!data/stations.json

# The cohort is the population PREREGISTRATION.md ยง6 evaluates the kill
# criterion on. It carries a SHA-256 over its own station list for exactly one
# reason: so a reader can check that the analysis used the cohort it claims to.
# Leaving it out of the repository makes that claim unverifiable, which is the
# same as not making it. A test asserts the digest and caught its absence.
!data/cohort_top200.json

# The preliminary estimator validation. A result, not an input.
!data/validation_preliminary.json
# The ยง4 run. Committed by the export job the moment it exists.
!data/validation_s4.json
# The ง5 ranking run, with the per-station estimate it ranks by.
!data/ranking_s5.json
# The busy-station check, designed after ง4/ง5. Labelled as such inside.
!data/busy_check.json

# Marts ARE tracked, despite being derived. Rebuilding one means pulling ~750 MB
# from the bucket, so a repository that carries them is a repository someone can
# actually reproduce the analysis from. They are ~2 MB a month and a closed month
# never changes again, so the history does not grow on rewrites.
# The manifests are tracked for a different reason: they are the only record of
# what was dropped on the way in, and cannot be regenerated at all (SRS FR-14).
!data/marts/
data/marts/*
!data/marts/manifest_*.json
!data/marts/trip_counts_*.parquet
# Weather is 257 KB and its manifest was already tracked without it, which left
# a provenance record for a file nobody else had. The conditions analysis cannot
# be reproduced from a clone without it.
!data/marts/weather_hourly.parquet
# Trip start times for the ยง4 window (~20 MB a month). The validation cannot be
# reproduced from a clone without them. Only the months it needs are written.
!data/marts/departures_*.parquet

# Web app
web/node_modules/
web/.next/
web/out/
web/next-env.d.ts
